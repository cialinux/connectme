POSTGRES_DB=connectme
POSTGRES_USER=connectme
POSTGRES_PASSWORD=replace-with-a-long-random-value
CONNECTME_DATABASE_URL=postgres://connectme:replace-with-a-long-random-value@postgres:5432/connectme?sslmode=disable
CONNECTME_ENV=development
CONNECTME_HTTP_ADDRESS=:8080
CONNECTME_MODULES=system=true
CONNECTME_MASTER_KEY=replace-with-base64-of-exactly-32-random-bytes
CONNECTME_AUDIT_HMAC_KEY=replace-with-another-base64-32-byte-random-key
CONNECTME_COOKIE_SECURE=false
CONNECTME_SESSION_TTL=12h
CONNECTME_SESSION_IDLE_TTL=30m
CONNECTME_GUACAMOLE_KEY=replace-with-32-hex-characters
CONNECTME_REMOTE_DENY_CIDRS=
# Global bypass of RDP server certificate verification; set false to verify identity.
CONNECTME_RDP_IGNORE_CERT=true
